/* pages/search/search.wxss —— 搜索页样式 */
.search-page {
  padding: 24rpx;
  background: #F4F5F7;
  min-height: 100vh;
  box-sizing: border-box;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 10rpx 20rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
}

.clear-btn {
  color: #bbb;
  font-size: 28rpx;
  padding: 0 12rpx;
}

.search-btn {
  margin: 0 0 0 12rpx;
  background: #FFB300;
  color: #fff;
}

.panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin: 16rpx 0 20rpx;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 26rpx;
  color: #FFB300;
  background: #FFF6E0;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  margin: 0 16rpx 16rpx 0;
}

.tag.hist {
  color: #666;
  background: #f2f2f2;
}

.result {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  min-height: 200rpx;
}

.empty {
  text-align: center;
  color: #aaa;
  font-size: 26rpx;
  padding: 60rpx 0;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.goods-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.goods-title {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-price {
  font-size: 30rpx;
  color: #FF5252;
  font-weight: 700;
  margin-top: 10rpx;
}
