<view class="page">
  <view class="header">
    <text class="title">我的发布</text>
    <view class="publish-btn" bindtap="goPublish">＋ 发布闲置</view>
  </view>

  <view wx:if="{{loading && list.length === 0}}" class="loading">加载中…</view>

  <view wx:elif="{{list.length === 0}}" class="empty">
    <text class="empty-icon">📦</text>
    <text class="empty-text">你还没有发布任何闲置</text>
    <view class="empty-btn" bindtap="goPublish">去发布</view>
  </view>

  <view wx:else class="list">
    <view class="card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <image class="cover" src="{{item.cover}}" mode="aspectFill" />
      <view class="info">
        <view class="name">{{item.title}}</view>
        <view class="meta">
          <text class="price">{{item.priceText}}</text>
          <text class="cat">{{item.categoryName}}</text>
        </view>
        <view class="tags">
          <text class="tag status">{{item.statusLabel}}</text>
          <text wx:if="{{item.auditLabel}}" class="tag audit">{{item.auditLabel}}</text>
        </view>
        <view class="time">{{item.createdText}}</view>
      </view>
    </view>
    <view wx:if="{{loading}}" class="loadmore">加载中…</view>
    <view wx:elif="{{finished}}" class="loadmore">没有更多了</view>
  </view>
</view>
