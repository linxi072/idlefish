.center { padding: 20rpx; }
.topbar { display: flex; align-items: center; justify-content: space-between; padding: 10rpx 10rpx 20rpx; }
.tb-title { font-size: 34rpx; font-weight: 700; }
.tb-link { font-size: 26rpx; color: var(--blue); }

.coupon { display: flex; background: #fff; border-radius: 20rpx; margin-bottom: 20rpx; overflow: hidden; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04); }
.c-left { flex: 1; padding: 28rpx; }
.c-desc { font-size: 40rpx; font-weight: 800; color: var(--red); }
.c-name { font-size: 28rpx; color: var(--t1); margin-top: 8rpx; }
.c-meta { margin-top: 14rpx; }
.c-valid { font-size: 22rpx; color: var(--t3); margin-top: 14rpx; }
.c-stock { font-size: 22rpx; color: var(--t3); margin-top: 6rpx; }
.c-right { width: 200rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--xy), var(--xy-deep)); }
.c-btn { background: #fff; color: #5A4000; font-size: 26rpx; font-weight: 700; padding: 16rpx 28rpx; border-radius: 32rpx; }
.c-btn.done { color: var(--t3); }
.c-btn.disabled { color: #fff; background: rgba(255,255,255,.4); }

.foot { text-align: center; color: var(--t3); font-size: 24rpx; padding: 24rpx 0; }
.empty { padding: 160rpx 0; text-align: center; color: var(--t3); }
.empty .icon { font-size: 96rpx; }
.empty .tip { margin-top: 20rpx; font-size: 26rpx; }
