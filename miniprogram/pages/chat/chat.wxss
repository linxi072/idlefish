.chat { display: flex; flex-direction: column; height: 100vh; background: #F4F5F7; }
.ctx-card { display: flex; align-items: center; background: #fff; padding: 16rpx 20rpx; border-bottom: 2rpx solid #F2F3F5; }
.ctx-img { width: 80rpx; height: 80rpx; border-radius: 10rpx; background: #eee; }
.ctx-info { flex: 1; margin-left: 16rpx; }
.ctx-title { font-size: 24rpx; color: var(--t1); }
.ctx-price { font-size: 26rpx; color: var(--red); font-weight: 700; }
.ctx-send { font-size: 24rpx; color: #7A5A00; background: var(--xy-light); padding: 10rpx 20rpx; border-radius: 24rpx; }
.msgs { flex: 1; padding: 20rpx; }
.msg { display: flex; margin-bottom: 24rpx; }
.msg.mine { justify-content: flex-end; }
.msg.peer { justify-content: flex-start; }
.bubble { max-width: 70%; padding: 18rpx 24rpx; border-radius: 20rpx; font-size: 28rpx; background: #fff; color: var(--t1); }
.msg.mine .bubble { background: linear-gradient(135deg,#FFCE3D,#FFB300); color: #5A4000; }
.card-msg { max-width: 70%; padding: 16rpx 20rpx; border-radius: 16rpx; background: #fff; border: 2rpx solid #FFE9B0; }
.card-tag { font-size: 20rpx; color: #7A5A00; background: var(--xy-light); padding: 2rpx 10rpx; border-radius: 6rpx; }
.card-title { font-size: 26rpx; color: var(--t1); margin-top: 8rpx; }
.card-msg.bargain { border-color: #FFD0D0; }
.input-bar { display: flex; align-items: center; padding: 16rpx 20rpx; background: #fff; }
.bargain-btn { font-size: 24rpx; color: var(--orange); border: 2rpx solid #FFD9B0; border-radius: 24rpx; padding: 10rpx 18rpx; margin-right: 16rpx; }
.t-input { flex: 1; background: #F2F3F5; border-radius: 36rpx; padding: 16rpx 24rpx; font-size: 28rpx; }
.send-btn { margin-left: 16rpx; font-size: 28rpx; font-weight: 600; color: #7A5A00; }
