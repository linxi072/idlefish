.act-detail { padding-bottom: 160rpx; }
.banner { width: 100%; height: 560rpx; background: #F2F3F5; }
.banner.ph { display: flex; align-items: center; justify-content: center; font-size: 120rpx; }

.info { margin: -40rpx 24rpx 0; position: relative; padding: 28rpx; }
.i-title { font-size: 32rpx; font-weight: 700; }
.i-type { display: inline-block; margin-top: 12rpx; }
.i-price { margin-top: 16rpx; display: flex; align-items: baseline; }
.i-price .price-lg { font-size: 52rpx; }
.i-price .symbol { font-size: 30rpx; }
.i-price .origin { font-size: 26rpx; color: var(--t3); text-decoration: line-through; margin-left: 14rpx; }

.meta { margin: 24rpx; }
.m-row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 2rpx solid #F2F3F5; font-size: 28rpx; }
.m-row:last-child { border-bottom: none; }
.m-k { color: var(--t2); }
.m-v { color: var(--t1); font-weight: 600; }
.m-v.countdown { color: var(--red); }

.progress-sec { margin: 24rpx; }
.sec-title { font-size: 30rpx; font-weight: 700; margin-bottom: 16rpx; }
.p-bar { height: 16rpx; background: #F0F1F4; border-radius: 8rpx; overflow: hidden; }
.p-in { height: 100%; background: linear-gradient(135deg, var(--red), var(--red-dark)); border-radius: 8rpx; }
.p-text { font-size: 24rpx; color: var(--t3); margin-top: 12rpx; }

.safe-tip { margin: 0 24rpx; font-size: 24rpx; color: var(--t2); background: var(--xy-light); padding: 16rpx 20rpx; border-radius: 12rpx; }

.action-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05); }
.join-btn { height: 92rpx; font-size: 32rpx; }
.join-btn.done { background: #F0F1F4; color: var(--t2); }
