.home { height: 100vh; display: flex; flex-direction: column; background: var(--bg); }
.topbar { padding: 16rpx 24rpx; background: #FFCE3D; }
.search { display: flex; align-items: center; background: #fff; border-radius: 40rpx; padding: 12rpx 20rpx; }
.s-icon { font-size: 28rpx; margin-right: 10rpx; }
.s-input { flex: 1; font-size: 28rpx; }
.s-btn { color: #7A5A00; font-weight: 600; font-size: 28rpx; padding-left: 16rpx; }
.scroll { flex: 1; }
.cats { display: flex; flex-wrap: wrap; margin: 20rpx; padding: 24rpx 12rpx; }
.cat { width: 20%; display: flex; flex-direction: column; align-items: center; margin-bottom: 20rpx; }
.cat-icon { width: 76rpx; height: 76rpx; line-height: 76rpx; text-align: center; border-radius: 24rpx; background: linear-gradient(135deg,#FFF6DA,#FFE9B0); color: #FFB300; font-size: 36rpx; font-weight: 700; }
.cat-name { font-size: 22rpx; color: var(--t2); margin-top: 10rpx; }
.banner { margin: 0 20rpx 20rpx; padding: 30rpx; border-radius: 20rpx; background: linear-gradient(135deg,#1A1A1A,#3A3A40); color: #fff; }
.banner-title { font-size: 30rpx; font-weight: 700; }
.banner-sub { font-size: 24rpx; color: #FFD86B; margin-top: 8rpx; }
.feed { display: flex; padding: 0 12rpx; }
.feed .col { flex: 1; padding: 0 8rpx; }
.item { background: #fff; border-radius: 18rpx; overflow: hidden; margin-bottom: 16rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04); }
.cover { width: 100%; height: 320rpx; background: #eee; }
.info { padding: 16rpx; }
.title { font-size: 26rpx; line-height: 36rpx; color: var(--t1); }
.meta { display: flex; align-items: center; margin-top: 12rpx; }
.price { font-size: 32rpx; }
.sub { display: flex; justify-content: space-between; margin-top: 10rpx; font-size: 20rpx; color: var(--t3); }
.loading, .nomore { text-align: center; color: var(--t3); font-size: 24rpx; padding: 24rpx; }
.fab { position: fixed; right: 40rpx; bottom: 60rpx; width: 100rpx; height: 100rpx; line-height: 100rpx; text-align: center; border-radius: 50%; background: linear-gradient(135deg,#FFCE3D,#FFB300); color: #5A4000; font-size: 60rpx; box-shadow: 0 10rpx 30rpx rgba(255,179,0,.4); }
