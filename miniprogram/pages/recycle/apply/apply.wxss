.rc-apply { padding: 20rpx 20rpx 160rpx; }
.rc-apply .card { margin-bottom: 20rpx; }
.sec-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.field { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 2rpx solid var(--border-subtle); }
.field.col { flex-direction: column; align-items: stretch; }
.label { width: 160rpx; flex-shrink: 0; font-size: 26rpx; color: var(--text-2); }
.input { flex: 1; font-size: 28rpx; color: var(--text-1); text-align: right; }
.picker { flex: 1; }
.picker-val { font-size: 28rpx; color: var(--text-1); text-align: right; }
.row3 { align-items: flex-end; }
.f3 { flex: 1; display: flex; flex-direction: column; margin-right: 12rpx; }
.f3:last-child { margin-right: 0; }
.f3 .label { width: auto; margin-bottom: 6rpx; }
.f3 .input { text-align: left; }
.seg { display: flex; gap: 16rpx; margin-top: 12rpx; }
.seg-item { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 16rpx; font-size: 26rpx; background: var(--surface-subtle); color: var(--text-2); border: 2rpx solid transparent; }
.seg-item.on { background: var(--primary-soft); color: var(--primary-ink); border-color: var(--primary); font-weight: 600; }
.est { text-align: center; }
.est-title { font-size: 26rpx; color: var(--text-2); }
.est-amt { font-size: 56rpx; font-weight: 700; color: var(--price); margin: 8rpx 0; }
.est-sub { font-size: 24rpx; color: var(--text-3); }
.est-tip { font-size: 22rpx; color: var(--text-3); margin-top: 12rpx; }
.est-na { font-size: 26rpx; color: var(--danger-strong); text-align: center; padding: 20rpx 0; }
.actions { display: flex; justify-content: center; margin: 8rpx 0 16rpx; }
.est-btn { padding: 0 48rpx; }
.action-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 16rpx 20rpx; background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.05); }
.btn-disabled { opacity: .5; }
