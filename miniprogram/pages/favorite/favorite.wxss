.page { padding: 20rpx 24rpx; background: #F4F5F7; min-height: 100vh; }
.empty { text-align: center; color: #9A9A9A; padding: 120rpx 0; font-size: 28rpx; }
.card { display: flex; background: #fff; border-radius: 16rpx; padding: 20rpx; margin-bottom: 20rpx; }
.cover { width: 160rpx; height: 160rpx; border-radius: 12rpx; background: #eee; flex-shrink: 0; }
.info { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; justify-content: space-between; }
.title { font-size: 30rpx; color: #222; line-height: 40rpx; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.meta { font-size: 24rpx; color: #9A9A9A; margin-top: 8rpx; }
.price { font-size: 32rpx; color: #FF5000; font-weight: 600; }
.tip { text-align: center; color: #b0b0b0; font-size: 24rpx; padding: 24rpx 0; }
