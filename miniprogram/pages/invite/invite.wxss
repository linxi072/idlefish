/* pages/invite/invite.wxss —— 邀请拉新页样式 */
.invite-page {
  padding: 24rpx;
  background: #F4F5F7;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.code-text {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #FFB300;
  font-family: monospace;
}

.copy-btn {
  margin: 0;
  background: #FFCE3D;
  color: #333;
}

.tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.bind-row {
  display: flex;
  align-items: center;
}

.bind-input {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  background: #F4F5F7;
  border-radius: 10rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.bind-btn {
  margin: 0;
  background: #FFB300;
  color: #fff;
}

.empty {
  text-align: center;
  color: #aaa;
  font-size: 26rpx;
  padding: 40rpx 0;
}

.invitee-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.invitee-item:last-child {
  border-bottom: none;
}

.invitee-info {
  display: flex;
  flex-direction: column;
}

.invitee-id {
  font-size: 28rpx;
  color: #333;
}

.invitee-time {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 6rpx;
}

.reward-tag {
  font-size: 24rpx;
  color: #999;
  background: #f2f2f2;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.reward-tag.rewarded {
  color: #fff;
  background: #FFB300;
}
