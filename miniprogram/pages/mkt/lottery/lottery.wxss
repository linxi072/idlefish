.page.mkt-lottery { padding: 20rpx; }
.card.goods { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.g-title { font-size: 30rpx; color: #1a1a1a; }
.g-sub { font-size: 22rpx; color: #999; margin-top: 8rpx; }

.card.sec { background: #fff; border-radius: 16rpx; padding: 40rpx 24rpx; margin-bottom: 20rpx; text-align: center; }
.turntable { font-size: 120rpx; margin-bottom: 20rpx; }
.tip { font-size: 24rpx; color: #999; margin-top: 20rpx; }

.result .r-emoji { font-size: 96rpx; }
.result .r-title { font-size: 32rpx; font-weight: 600; color: #1a1a1a; margin: 12rpx 0; }
.result .r-prize { font-size: 30rpx; color: #FF4D4F; font-weight: 600; }
.result .r-extra { font-size: 24rpx; color: #07c160; margin-top: 10rpx; }
.result.lose .r-prize { color: #999; font-weight: 400; }

.field { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.field .label { width: 160rpx; text-align: left; font-size: 26rpx; color: #555; }
.field .input { flex: 1; text-align: left; font-size: 28rpx; }
.sec-title { font-size: 28rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 12rpx; text-align: left; }

.btn { text-align: center; padding: 26rpx 0; border-radius: 44rpx; font-size: 30rpx; margin-top: 16rpx; }
.btn-primary { background: #7C5CFF; color: #fff; font-weight: 600; }
