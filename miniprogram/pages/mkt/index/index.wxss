.page.mkt-index { padding: 20rpx; }
.tabs {
  display: flex; background: #fff; border-radius: 16rpx; padding: 10rpx;
  margin-bottom: 20rpx; position: sticky; top: 0; z-index: 10;
}
.tab { flex: 1; text-align: center; padding: 18rpx 0; font-size: 28rpx; color: #666; border-radius: 12rpx; }
.tab.active { background: #FFB300; color: #fff; font-weight: 600; }

.card.act {
  display: flex; background: #fff; border-radius: 16rpx; padding: 20rpx; margin-bottom: 20rpx;
}
.act-img { width: 200rpx; height: 200rpx; border-radius: 12rpx; }
.act-ph { width: 200rpx; height: 200rpx; border-radius: 12rpx; background: #f4f5f7; display: flex; align-items: center; justify-content: center; font-size: 64rpx; }
.act-info { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; }
.act-kind { align-self: flex-start; font-size: 22rpx; color: #fff; background: #FFB300; padding: 2rpx 12rpx; border-radius: 8rpx; margin-bottom: 8rpx; }
.act-kind.k-LOTTERY { background: #7C5CFF; }
.act-kind.k-SECKILL { background: #FF4D4F; }
.act-title { font-size: 28rpx; color: #1a1a1a; line-height: 1.4; }
.act-price { margin-top: auto; display: flex; align-items: baseline; }
.act-price .price { font-size: 34rpx; color: #FF4D4F; font-weight: 700; }
.act-price .origin { font-size: 24rpx; color: #999; text-decoration: line-through; margin-left: 12rpx; }
.act-bar { height: 12rpx; background: #f0f0f0; border-radius: 6rpx; margin: 12rpx 0 6rpx; overflow: hidden; }
.act-bar-in { height: 100%; background: linear-gradient(90deg, #FFB300, #FF7A00); }
.act-meta { font-size: 22rpx; color: #999; }
.empty { text-align: center; padding: 120rpx 0; color: #999; }
.empty .icon { font-size: 80rpx; }
.empty .tip { margin-top: 16rpx; font-size: 26rpx; }
