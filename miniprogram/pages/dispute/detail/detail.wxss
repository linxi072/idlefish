.dd { padding: 24rpx; padding-bottom: 160rpx; }
.status-banner { border-radius: 16rpx; padding: 32rpx 28rpx; margin-bottom: 24rpx; color: #fff; }
.s-PENDING { background: linear-gradient(135deg, #fa8c16, #ffa940); }
.s-SELLER_REPLIED { background: linear-gradient(135deg, #1890ff, #40a9ff); }
.s-PLATFORM { background: linear-gradient(135deg, #722ed1, #9254de); }
.s-RESOLVED { background: linear-gradient(135deg, #52c41a, #73d13d); }
.s-CANCELED { background: #bfbfbf; }
.s-CLOSED { background: #8c8c8c; }
.sb-title { font-size: 36rpx; font-weight: 700; }
.sb-sub { font-size: 24rpx; opacity: 0.92; margin-top: 8rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.sec-title { font-size: 28rpx; color: #333; font-weight: 600; margin-bottom: 16rpx; }
.desc { font-size: 28rpx; color: #555; line-height: 1.6; }
.remark { margin-top: 12rpx; color: #888; font-size: 26rpx; }
.a-row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; font-size: 28rpx; border-bottom: 2rpx solid #f5f5f5; }
.a-row:last-child { border-bottom: none; }
.a-row text:first-child { color: #999; }
.t2 { color: #333; }
.price { color: #ff6022; font-weight: 600; }
.result { background: #f6ffed; }
.action-bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; flex-wrap: wrap; gap: 16rpx; padding: 20rpx 24rpx; background: #fff; border-top: 2rpx solid #f0f0f0; }
.btn { flex: 1; min-width: 200rpx; text-align: center; padding: 22rpx 0; border-radius: 999rpx; font-size: 28rpx; }
.btn-ghost { background: #f4f5f7; color: #555; }
.btn-red { background: #fff1f0; color: #f5222d; }
.loading, .empty { text-align: center; color: #999; padding: 120rpx 40rpx; font-size: 28rpx; }
