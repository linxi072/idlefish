.da { padding: 24rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.goods { display: flex; align-items: center; }
.g-img { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #f2f2f2; }
.g-info { margin-left: 20rpx; flex: 1; }
.g-title { font-size: 28rpx; color: #222; }
.g-price { margin-top: 12rpx; font-size: 30rpx; color: #ff6022; font-weight: 600; }
.ineligible { background: #fff7e6; color: #ad6800; border-radius: 12rpx; padding: 20rpx; font-size: 26rpx; margin-bottom: 24rpx; }
.sec-title { font-size: 28rpx; color: #333; font-weight: 600; margin-bottom: 16rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip { padding: 14rpx 28rpx; border-radius: 999rpx; background: #f4f5f7; color: #555; font-size: 26rpx; border: 2rpx solid transparent; }
.chip.on { background: #fff3e0; color: #ff6022; border-color: #ff6022; font-weight: 600; }
.field { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 2rpx solid #f0f0f0; }
.field.col { flex-direction: column; align-items: stretch; border-bottom: none; }
.label { font-size: 28rpx; color: #333; width: 200rpx; }
.input { flex: 1; text-align: right; font-size: 28rpx; }
.fillall { margin-left: 16rpx; color: #ff6022; font-size: 26rpx; }
.textarea { width: 100%; height: 180rpx; margin-top: 16rpx; font-size: 28rpx; background: #f7f8fa; border-radius: 12rpx; padding: 16rpx; box-sizing: border-box; }
.counter { text-align: right; font-size: 24rpx; color: #aaa; margin-top: 8rpx; }
.submit { margin-top: 12rpx; background: #ff6022; color: #fff; border-radius: 999rpx; }
.btn-block { width: 100%; }
