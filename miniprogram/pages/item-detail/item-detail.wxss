.detail { padding-bottom: 120rpx; background: var(--bg); min-height: 100vh; }
.gallery { width: 100%; height: 750rpx; background: #000; }
.g-img { width: 100%; height: 100%; }
.img-index { position: absolute; top: 700rpx; right: 30rpx; background: rgba(0,0,0,.5); color: #fff; font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 20rpx; }
.price-bar { display: flex; align-items: baseline; padding: 24rpx; background: #fff; }
.original { color: var(--t4); font-size: 26rpx; text-decoration: line-through; margin-left: 16rpx; }
.title { padding: 8rpx 24rpx; font-size: 34rpx; font-weight: 600; background: #fff; }
.tags { display: flex; padding: 16rpx 24rpx; background: #fff; }
.seller { display: flex; align-items: center; margin: 20rpx; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: #eee; }
.s-info { flex: 1; margin-left: 20rpx; }
.s-name { font-size: 28rpx; font-weight: 600; }
.s-credit { font-size: 22rpx; color: var(--t3); margin-top: 6rpx; }
.desc { margin: 0 20rpx 20rpx; }
.sec-title { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.desc-text { font-size: 26rpx; color: var(--t2); line-height: 42rpx; }
.safe-tip { margin: 0 20rpx 20rpx; padding: 18rpx 24rpx; background: var(--xy-light); color: #7A5A00; font-size: 24rpx; border-radius: 14rpx; }
.action-bar { position: fixed; left: 0; right: 0; bottom: 0; height: 110rpx; background: #fff; display: flex; align-items: center; padding: 0 20rpx; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.05); }
.act { width: 110rpx; display: flex; flex-direction: column; align-items: center; color: var(--t2); }
.act-ico { font-size: 40rpx; }
.act-txt { font-size: 20rpx; margin-top: 4rpx; }
.buy-sm { flex: 1; margin-left: 20rpx; color: #5A4000; }
