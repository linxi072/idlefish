<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.idlefish</groupId>
    <artifactId>idlefish-backend</artifactId>
    <version>1.0.0</version>
    <name>idlefish-backend</name>
    <description>闲置集 C2C 二手交易小程序后端（V1.0 单体架构）</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <jjwt.version>0.12.6</jjwt.version>
        <!-- 离线沙箱 ~/.m2 已缓存 8.1.0；联网构建可自由升级到 8.4.0 -->
        <mysql.version>8.1.0</mysql.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Redis（生产缓存，需联网下载） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- MyBatis-Plus (Spring Boot 3) -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL 驱动（生产数据源；local/prod 共用，离线缓存 8.1.0 即可编译） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.version}</version>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
      依赖治理（T08）：依赖版本收敛（BOM 收敛）。
      Spring Boot parent 已通过 spring-boot-dependencies BOM 统一管理绝大多数传递依赖版本；
      此处仅将项目“显式声明”的 3 个非 Spring 依赖纳入统一版本治理，作为单一可信源，
      避免版本号散落在 <dependencies> 中造成漂移，并便于离线/CI 审计。
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!--
          依赖治理（T08）：固定关键构建插件版本，确保离线/CI 构建可复现（不随 parent 默认版本漂移）。
          仅固定“离线仓库已缓存”的版本，避免离线环境解析失败。未在此声明的插件仍由 parent 管理。
        -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>3.3.4</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
      构建说明（离线安全 + 生产就绪）：
      - 缓存架构：系统唯一缓存组件为 Redis（spring-boot-starter-data-redis 已作为普通依赖，
        离线 .m2 已缓存，可 mvn -o 离线编译）。本地运行需自备 Redis 实例（application.yml 默认 127.0.0.1:6379），
        不再保留本地内存缓存实现（已从 common/cache 移除 LocalCacheServiceImpl）。
      - 数据源：MySQL 8.1.0（离线已缓存），本地运行需自备 MySQL 实例（application.yml 默认 127.0.0.1:3306/idlefish）。
      - Profile：原 local/prod 双 profile 隔离已不再需要，默认构建即包含全部依赖；
        prod profile 仅用于通过 spring.profiles.active=prod 启动参数切换数据源/SQL 方言，缓存恒为 Redis。
      - micrometer profile（F-12.6 可观测性增强，T01 起默认激活）：通过 activeByDefault 默认引入
        spring-boot-starter-actuator + micrometer-registry-prometheus，并通过 build-helper 将独立的
        src/main/micrometer/java 源码根纳入编译。离线 .m2 已缓存上述依赖，
        故默认离线 mvn -o 也能编译并暴露 /actuator/prometheus（REQ-01）。如需关闭，可显式
        -P!micrometer 或 -Dspring.profiles.default 覆盖。该 profile 专属源码（MicrometerMetricsBridge
        + 6 个 DependencyHealthIndicator）把零依赖 MetricsRegistry 桥接为 Prometheus 指标，并复用
        DependencyProbes 提供 K8s liveness/readiness 聚合。
      说明：H2 内存库已彻底移除。
    -->

    <!--
      F-12.6 Micrometer / Prometheus 可观测性增强（T01 起默认激活，REQ-01）。
      离线 .m2 已缓存 actuator + micrometer-registry-prometheus，故默认离线 mvn -o 即可编译暴露
      /actuator/prometheus。activeByDefault 表示未显式指定其它 profile 时自动生效；
      若需临时关闭可 -P!micrometer（注意：关闭后 ObservabilityController 端点接管 /actuator/health）。
    -->
    <profiles>
        <profile>
            <id>micrometer</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-actuator</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.micrometer</groupId>
                    <artifactId>micrometer-registry-prometheus</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>add-micrometer-sources</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/main/micrometer/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          依赖治理（T08）：可显式激活的“治理门禁” profile（默认关闭，避免离线构建因缺少
          maven-enforcer-plugin 而失败）。CI / 私服环境通过 -Pgovernance 启用，强制：
            - Maven>=3.9 / Java=17 基线
            - 禁止 POM 内重复声明不同版本（banDuplicatePomDependencyVersions）
            - 依赖版本收敛（dependencyConvergence）：存在传递版本冲突时构建失败，必须显式解决
          该 profile 依赖 maven-enforcer-plugin（3.5.0），需提前置入私服/本地仓库（见
          scripts/dependency-governance.sh 与 docs/依赖治理与离线构建可复现.md）。
        -->
        <profile>
            <id>governance</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>enforce-governance</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireMavenVersion>
                                            <version>[3.9,)</version>
                                        </requireMavenVersion>
                                        <requireJavaVersion>
                                            <version>17</version>
                                        </requireJavaVersion>
                                        <banDuplicatePomDependencyVersions/>
                                        <dependencyConvergence/>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
