{
  "domain": "admin",
  "description": "运营后台：鉴权、商品审核、用户、风控审计、风控规则、系统、财务、订单、评价、券",
  "endpoints": [
    {
      "method": "POST",
      "path": "/api/admin/auth/login",
      "auth": "none",
      "expectStatus": 200,
      "expectFields": ["data.token"],
      "notes": "后台登录（密码 PBKDF2 哈希校验）；错误密码返回 20001"
    },
    {
      "method": "GET",
      "path": "/api/admin/items",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data.total", "data.records"],
      "notes": "商品审核列表，支持 keyword/status 下推"
    },
    {
      "method": "POST",
      "path": "/api/admin/items/{itemId}/approve",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "审核通过，写审计日志"
    },
    {
      "method": "POST",
      "path": "/api/admin/items/{itemId}/reject",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "审核拒绝"
    },
    {
      "method": "GET",
      "path": "/api/admin/users",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data.total", "data.records"],
      "notes": "用户列表，支持 keyword 下推"
    },
    {
      "method": "POST",
      "path": "/api/admin/users/{userId}/ban",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "封禁用户（联动风控冻结）"
    },
    {
      "method": "GET",
      "path": "/api/admin/audit-logs",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data.total", "data.records"],
      "notes": "审计日志列表"
    },
    {
      "method": "GET",
      "path": "/api/admin/risks",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "风控事件列表"
    },
    {
      "method": "GET",
      "path": "/api/admin/risk/rules",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "风控规则库（可配置，热加载）"
    },
    {
      "method": "PUT",
      "path": "/api/admin/risk/rules",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "保存规则并热加载（无需重启）"
    },
    {
      "method": "POST",
      "path": "/api/admin/risk/rules/{code}/toggle",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "切换规则启用状态并热加载"
    },
    {
      "method": "GET",
      "path": "/api/admin/system/menu/tree",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "菜单树"
    },
    {
      "method": "GET",
      "path": "/api/admin/system/user",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data.records"],
      "notes": "系统用户列表"
    },
    {
      "method": "GET",
      "path": "/api/admin/system/role",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data.records"],
      "notes": "角色列表"
    },
    {
      "method": "GET",
      "path": "/api/admin/system/organization/tree",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "组织机构树"
    },
    {
      "method": "GET",
      "path": "/api/admin/system/dict/dropdown",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "字典下拉"
    },
    {
      "method": "GET",
      "path": "/api/admin/withdrawals",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data.records"],
      "notes": "提现审批列表"
    },
    {
      "method": "POST",
      "path": "/api/admin/withdrawals/{id}/approve",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "提现审批通过（真实出款，配置硬网关）"
    },
    {
      "method": "POST",
      "path": "/api/admin/withdrawals/{id}/reject",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "提现驳回（回滚冻结）"
    },
    {
      "method": "GET",
      "path": "/api/admin/reconciliation",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "资金对账结果"
    },
    {
      "method": "POST",
      "path": "/api/admin/settlements/{id}/unfreeze",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "结算单解冻"
    },
    {
      "method": "GET",
      "path": "/api/admin/orders",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data.records"],
      "notes": "订单管理列表"
    },
    {
      "method": "POST",
      "path": "/api/admin/orders/{orderNo}/ship",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "后台代发货"
    },
    {
      "method": "POST",
      "path": "/api/admin/orders/{orderNo}/refund",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "后台介入退款"
    },
    {
      "method": "GET",
      "path": "/api/admin/reviews",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data.records"],
      "notes": "评价管理列表"
    },
    {
      "method": "POST",
      "path": "/api/admin/reviews/{id}/approve",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "评价通过"
    },
    {
      "method": "POST",
      "path": "/api/admin/reviews/{id}/reject",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "评价驳回"
    },
    {
      "method": "POST",
      "path": "/api/admin/coupon/create",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "创建优惠券"
    },
    {
      "method": "POST",
      "path": "/api/admin/coupon/status",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "切换券状态"
    },
    {
      "method": "GET",
      "path": "/api/admin/marketing/coupon/overview",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data.issuedCount", "data.redeemedCount", "data.redemptionRate", "data.redeemedGmv", "data.discountCost", "data.roi"],
      "notes": "F-13.5 券营销概览：发放量/核销率/核销GMV/优惠成本/ROI"
    },
    {
      "method": "GET",
      "path": "/api/admin/marketing/coupon/type-dist",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "F-13.5 券类型发放分布"
    },
    {
      "method": "GET",
      "path": "/api/admin/analytics/overview",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data.gmv", "data.refundRate", "data.avgOrderValue", "data.trend"],
      "notes": "F-15.5 运营概览：GMV/订单/退款率/客单价/趋势"
    },
    {
      "method": "GET",
      "path": "/api/admin/analytics/funnel",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "F-15.5 转化漏斗：浏览/搜索/收藏/下单/支付及转化率"
    },
    {
      "method": "GET",
      "path": "/api/admin/analytics/category",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "F-15.5 品类 GMV 分布"
    },
    {
      "method": "GET",
      "path": "/api/admin/analytics/condition",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "F-15.5 商品成色分布"
    },
    {
      "method": "GET",
      "path": "/api/admin/analytics/export",
      "auth": "admin",
      "expectStatus": 200,
      "notes": "F-15.5 CSV 导出（type=summary|gmv|funnel|category|condition），返回 text/csv"
    },
    {
      "method": "GET",
      "path": "/api/admin/member/level/list",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "F-13.2 会员等级配置清单"
    },
    {
      "method": "POST",
      "path": "/api/admin/member/level/save",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data"],
      "notes": "F-13.2 新增/更新等级配置"
    },
    {
      "method": "POST",
      "path": "/api/admin/member/level/delete",
      "auth": "admin",
      "expectStatus": 200,
      "notes": "F-13.2 删除等级配置"
    },
    {
      "method": "GET",
      "path": "/api/admin/member/level/growth",
      "auth": "admin",
      "expectStatus": 200,
      "expectFields": ["data.records", "data.total"],
      "notes": "F-13.2 会员成长值概览（分页）"
    }
  ]
}
